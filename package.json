{
  "name": "zlearn-cli",
  "version": "0.4.1",
  "description": "Understand the code your AI agent writes. A knowledge map from git, attested reviews and a team dashboard. No API key needed.",
  "keywords": [
    "zlearn",
    "ai",
    "code-review",
    "comprehension-debt",
    "claude-code",
    "cursor",
    "codex",
    "agentic-coding",
    "bus-factor",
    "knowledge-map"
  ],
  "homepage": "https://zevqi.com",
  "bugs": {
    "url": "https://github.com/zevqi/zlearn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zevqi/zlearn.git"
  },
  "license": "MIT",
  "author": "Neha Singh <hello@zevqi.com>",
  "bin": {
    "zlearn": "packages/cli/dist/cli.js"
  },
  "files": [
    "packages/cli/dist",
    "packages/cli/package.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:cli": "npm run build --prefix packages/cli",
    "typecheck": "npm run typecheck --prefix packages/cli",
    "test": "npm test --prefix packages/cli",
    "prepublishOnly": "node -e \"require('fs').accessSync('packages/cli/dist/cli.js')\""
  }
}
